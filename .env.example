# Database connection URL. SQLite only: the value must start with file:.
# In the container the image sets file:/data/rabbit-maximizer.db.
DATABASE_URL=file:./data/rabbit-maximizer.db

# Detection mode: poll or webhook
DETECTION_MODE=poll

# GitHub fine-grained Personal Access Token
# Create one at: https://github.com/settings/personal-access-tokens/new
#
# Required repository permissions:
#   issues:        read & write  (search comments, read PR comments, post retrigger)
#   pull_requests: read          (read PR status / merge state)
#   metadata:      read          (auto-included)
#
# Must be a user PAT (NOT a GitHub App token) — CodeRabbit ignores [bot] identities.
GITHUB_PAT=

# GitHub API timeout in seconds (default: 10)
GITHUB_API_TIMEOUT_SEC=10

# Log level — one of: trace, debug, info, warn, error, fatal (default: info)
LOG_LEVEL=debug

# Also write logs to a rolling file under RABBIT_MAXIMIZER_LOGS_DIR (default: true).
# The container image sets this to false and logs to stdout only.
LOG_TO_FILE=true

# Directory that holds the rolling log file (default: ./logs)
RABBIT_MAXIMIZER_LOGS_DIR=./logs

# Build identity, recorded on every log record and in every posted comment.
# The image sets RUN_KIND=docker and receives GIT_SHA and IMAGE_TAGS from the
# build. The `pnpm dev` and `pnpm local` scripts set RUN_KIND=local and read
# GIT_SHA from the working tree. A value with no source reads "unknown", and
# nothing here needs uncommenting.
# RUN_KIND=local
# GIT_SHA=1a2b3c4
# IMAGE_TAGS=edge,sha-1a2b3c4

# Maximum number of lifetime retrigger attempts per PR before marking the queue item failed (default: 10)
MAX_RETRIGGER_ATTEMPTS=10

# Delay in seconds before showing the first "paused" browser notification (default: 1800)
PAUSE_NOTIFICATION_INITIAL_DELAY_SEC=1800

# Interval in seconds between repeat "paused" notifications (default: 900)
PAUSE_NOTIFICATION_REPEAT_INTERVAL_SEC=900

# Polling interval in seconds (only used when DETECTION_MODE=poll)
POLL_INTERVAL_SEC=90

# Repository filter — JSON array of user patterns or explicit repos.
# Wildcards: ["couimet/*"] searches all repos under that user (uses `user:` qualifier).
#   ⚠ Org accounts not yet supported — https://github.com/couimet/rabbit-maximizer/issues/11
# Explicit:  ["couimet/rabbit-maximizer", "other-org/specific-repo"]
# Mixed:     ["couimet/*", "other-org/single-repo"]
# A bare string (no brackets) is treated as a single-entry list.
REPO_FILTER=["couimet/*"]

# ReviewDetector: lookback window in seconds for detecting reviews posted before retriggered_at (default: 7200 = 2 hours)
REVIEW_DETECTION_LOOKBACK_SEC=7200

# Scheduler: buffer in seconds added to the CodeRabbit review-limit wait time to avoid retrying
# exactly at the boundary (default: 60)
REVIEW_LIMIT_BUFFER_SEC=60

# CodeRabbit account-level cooldown in seconds between review requests across all PRs (default: 3600 = 1 hour)
CODERABBIT_ACCOUNT_COOLDOWN_SEC=3600

# CodeRabbit comment-body phrases. Every phrase is matched as a case-sensitive substring of
# the comment body, so a change in CodeRabbit's wording needs a change here, not a release.
# Every key takes a JSON array, or a bare single phrase.

# Phrases that mark a CodeRabbit acknowledgement reply to a retrigger (default: the bot reply marker)
CODERABBIT_ACKNOWLEDGEMENT_PHRASES=["auto-generated reply by CodeRabbit"]

# Phrases that mark a CodeRabbit review with no actionable comments (default: the approval marker)
CODERABBIT_APPROVAL_PHRASES=["No actionable comments were generated in the recent review."]

# Phrases that mark a CodeRabbit review with actionable comments (default: the changes-suggested marker)
CODERABBIT_CHANGES_SUGGESTED_PHRASES=["Actionable comments posted:"]

# Phrases that mark a CodeRabbit pause comment. CodeRabbit pauses a review that it intends to
# resume, so a match retriggers the PR (default: the pause marker)
CODERABBIT_PAUSE_PHRASES=["review paused by coderabbit.ai"]

# Phrases that mark a CodeRabbit rate-limit comment (default: the rate-limit marker)
CODERABBIT_RATE_LIMIT_PHRASES=["rate limited by coderabbit.ai"]

# Phrases that mark a CodeRabbit comment as a permanent refusal. A refused PR leaves the
# queue with resolution permanently_refused and never returns until an operator re-queues it.
# The refusal check runs first, because a refusal comment also carries the skip marker.
CODERABBIT_REFUSAL_PHRASES=["without an assigned CodeRabbit review seat"]

# Phrases that mark a CodeRabbit skip-review comment (default: the skip marker)
CODERABBIT_SKIP_PHRASES=["skip review by coderabbit.ai"]

# Phrases that mark a CodeRabbit walkthrough comment. A walkthrough carries no verdict, but it
# records that CodeRabbit worked on the PR (default: the review stack entry marker)
CODERABBIT_WALKTHROUGH_PHRASES=["review_stack_entry_start"]

# Pull request authors to leave out of monitoring. A match resolves the queue item with
# resolution excluded and shows the PR as ignored on the dashboard. Nothing is stored on
# the PR row, so removing the rule brings the PR back.
# Each entry is an unanchored regular expression, matched against the author login.
# JSON array, or a bare single pattern.
#   IGNORE_AUTHORS=["^dependabot\\[bot\\]$", "^renovate"]
IGNORE_AUTHORS=[]

# Pull request titles to leave out of monitoring. Each entry is an unanchored regular
# expression, matched against the current title, so a retitle ends the match.
# JSON array, or a bare single pattern.
#   IGNORE_TITLES=["^\\[WIP\\]", "[skip review]"]
IGNORE_TITLES=[]

# Scheduler: max PR-state fetches per tick while scanning for the next due item (default: 5)
SCHEDULER_MAX_PR_STATE_FETCHES_PER_TICK=5

# Scheduler: minimum spacing in seconds between successive retriggers for the same PR (default: 180)
SCHEDULER_RETRIGGER_SPACING_SEC=180

# Scheduler: base backoff in seconds for the first unknown-error retry (default: 60)
SCHEDULER_RETRY_BACKOFF_BASE_SEC=60

# Scheduler: maximum backoff cap in seconds (default: 3600 = 1 hour).
# Independent of CODERABBIT_ACCOUNT_COOLDOWN_SEC — this caps retry wait times, not the review window.
SCHEDULER_RETRY_BACKOFF_MAX_SEC=3600

# Scheduler: tick interval in seconds (default: 10)
SCHEDULER_TICK_INTERVAL_SEC=10

# Head-drift recovery: grace window in seconds between a push and the sweep that enqueues the
# head. The window gives the CodeRabbit comment path its turn first (default: 900 = 15 minutes)
HEAD_DRIFT_GRACE_SEC=900

# Web server port for the dashboard and API (default: 3000)
WEB_PORT=3000

# --- Webhook mode only (uncomment if DETECTION_MODE=webhook) ---
# WEBHOOK_SECRET=
# TUNNEL_URL=
